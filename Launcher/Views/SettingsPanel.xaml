<UserControl x:Class="MorrowindRemasteredLauncher.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MorrowindRemasteredLauncher.Converters"
             xmlns:local="clr-namespace:MorrowindRemasteredLauncher.Views">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <!-- One control template per SettingControl kind. DataContext is the
             SettingRowViewModel, so controls bind directly to its value props. -->
        <DataTemplate x:Key="ToggleTpl">
            <CheckBox Style="{StaticResource PlainCheckBox}"
                      IsChecked="{Binding BoolValue}" />
        </DataTemplate>

        <DataTemplate x:Key="DropdownTpl">
            <ComboBox Style="{StaticResource PlainComboBox}"
                      ItemContainerStyle="{StaticResource PlainComboBoxItem}"
                      ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedOption}" />
        </DataTemplate>

        <DataTemplate x:Key="SliderTpl">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" VerticalAlignment="Center"
                        Style="{StaticResource PlainSlider}"
                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                        Value="{Binding DoubleValue}" />
                <TextBlock Grid.Column="1" Margin="8,0,0,0"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding DoubleValue, StringFormat=0.##}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NumberTpl">
            <TextBox Style="{StaticResource PlainTextInput}" Width="80"
                     HorizontalAlignment="Left"
                     Text="{Binding DoubleValue, StringFormat=0.##,
                            UpdateSourceTrigger=LostFocus}" />
        </DataTemplate>

        <DataTemplate x:Key="TextTpl">
            <TextBox Style="{StaticResource PlainTextInput}"
                     Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" />
        </DataTemplate>

        <local:SettingControlTemplateSelector x:Key="ControlSelector"
            ToggleTemplate="{StaticResource ToggleTpl}"
            DropdownTemplate="{StaticResource DropdownTpl}"
            SliderTemplate="{StaticResource SliderTpl}"
            NumberTemplate="{StaticResource NumberTpl}"
            TextTemplate="{StaticResource TextTpl}" />

        <!-- One section per category: a collapsible accordion header + its rows. -->
        <DataTemplate x:Key="CategoryTpl">
            <StackPanel Margin="0,10,0,0">
                <!-- Header: chevron (rotates down when open) + category name. Clicking
                     toggles the accordion (only one section open at a time). -->
                <Button Cursor="Hand" HorizontalContentAlignment="Left" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding DataContext.ToggleCategoryCommand,
                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="0,4">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="chev" Data="M 0,0 L 4,4 L 0,8"
                                          Width="9" Height="10"
                                          Stroke="{StaticResource AccentInkBrush}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="hdr" Text="{Binding Name}"
                                               FontWeight="SemiBold" FontSize="15"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <!-- Open: downward chevron (v). Closed: right chevron (>). -->
                                    <Setter TargetName="chev" Property="Data" Value="M 0,0 L 4,4 L 8,0" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="chev" Property="Stroke" Value="Black" />
                                    <Setter TargetName="hdr" Property="Foreground" Value="Black" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <ItemsControl ItemsSource="{Binding Rows}" Margin="16,2,0,4"
                              Visibility="{Binding IsExpanded,
                                           Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding}"
                                                VerticalAlignment="Center"
                                                ContentTemplateSelector="{StaticResource ControlSelector}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Description}"
                                           Style="{StaticResource SubtleText}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"
                                           Visibility="{Binding HasDescription,
                                                        Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource HeaderText}" />
            <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="These apply to the selected edition and take effect the next time you play. Changes are saved as you make them." />

            <!-- Shown when the selected edition isn't installed yet. -->
            <TextBlock Style="{StaticResource SubtleText}" Margin="0,18,0,0" TextWrapping="Wrap"
                       Text="Install this edition to edit its settings."
                       Visibility="{Binding HasSettings, Converter={StaticResource InverseBoolToVis}}" />

            <ItemsControl ItemsSource="{Binding SettingCategories}"
                          ItemTemplate="{StaticResource CategoryTpl}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
