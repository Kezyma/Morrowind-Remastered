<UserControl x:Class="MorrowindRemasteredLauncher.Views.ToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MorrowindRemasteredLauncher.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <StackPanel>
            <TextBlock Text="Tools" Style="{StaticResource HeaderText}" />
            <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Launch a tool in Mod Organizer to configure it manually. (The guided setup steps now live on the Install page.)" />

            <!-- Config-driven tools for the selected edition -->
            <ItemsControl ItemsSource="{Binding ToolLaunches}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}"
                                           Style="{StaticResource SubtleText}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding HasDescription,
                                                        Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Launch" VerticalAlignment="Center"
                                    Style="{StaticResource TextButton}"
                                    Command="{Binding DataContext.LaunchToolCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
